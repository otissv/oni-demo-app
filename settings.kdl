window {
    mode window
    title "Oni GUI"
    width 1280
    height 720
    min-width 320
    min-height 180
}
dpi {
    scale 1.5
    subpixel auto
}
fonts {
    body-size 14
    heading-size 20
    family Inter {
        face {
            path "assets/fonts/Inter-VariableFont_opsz,wght.ttf"
            style normal
            weight normal
        }
        face {
            path "assets/fonts/Inter-Italic-VariableFont_opsz,wght.ttf"
            style italic
            weight normal
        }
    }
}
shortcuts {
}
